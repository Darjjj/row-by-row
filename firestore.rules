rules_version = '2';
// The published Firestore rules (Firebase console > Firestore Database > Rules), kept here as a record.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's own synced data: patterns, progress, notes. Nobody else can read or write it from the app.
    // Notes sent to the inbox live here too; tools/read_feedback.py reads them with a read-only service account.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
