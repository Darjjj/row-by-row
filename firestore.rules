rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's own synced data: patterns, progress, notes.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Feedback inbox: a signed-in person can send notes as themselves. Nobody can read them from the app;
    // they're read on the computer with a read-only service account (tools/read_feedback.py).
    match /feedback/{id} {
      allow create, update: if request.auth != null
        && id.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'text', 'at', 'where', 'device', 'sent'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && request.resource.data.where is string && request.resource.data.where.size() <= 300
        && request.resource.data.device is string && request.resource.data.device.size() <= 300;
    }
  }
}
